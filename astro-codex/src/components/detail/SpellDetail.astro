const statusTooltipsFr: Record<string, string> = {
  'Blinded': 'Ne peut ni attaquer ni se défendre ; échec auto perception',
  'Paralyzed': 'Ne peut pas agir. Attaques mêlée touchent auto',
  'Incapacitated': 'Ne peut pas agir. Annulé si subit des dégâts',
  'Immobilized': 'Ne peut pas se déplacer. Peut agir sur place',
  'Knocked Down': 'Au sol. Mêlée +2 / Distance -2 contre la cible',
  'Mind Controlled': 'Contrôlé par le lanceur',
  'Hallucinating': 'Doit attaquer la créature la plus proche',
  'Grappled': 'Ne peut pas se déplacer. Peut agir',
  'Restrained': 'Immobile, -2 attaques, attaquants +2',
  'Equipment Disabled': 'Exosquelette et électronique désactivés',
  'Suppressed': '-4 à toutes les actions, cloué au sol',
  'Camouflaged': 'Caché. Jet de PER opposé pour détecter',
  'Frostbite': '-1 vitesse/-1 toucher par accumulation. 5 = 2d20+8',
  'Burning': 'Dégâts de feu chaque tour (1d4 à 4d6)',
  'Weakened': '-X à tous les jets',
  'Slowed': '-X à la vitesse de déplacement',
  'Fatigued': '-X à tous les jets, vitesse réduite de moitié',
  'Hasted': 'Actions supplémentaires et vitesse accrue',
  'Shielded': '+X Score de Défense et/ou réduction de dégâts',
  'Reinforced': '+X à toutes les résistances (RMEC, RRAD, RINT)',
  'Deflecting': 'Dévie automatiquement les projectiles',
  'Arcanotechnically Resistant': '+X résistance aux effets arcanotechniques',
};

function statusTooltip(enName: string, locale: string): string {
  return (locale === 'fr' ? statusTooltipsFr : statusTooltipsEn)[enName] || '';
}

function translateStatus(enName: string, locale: string): string {
  if (locale === 'fr') return statusTranslations[enName] || enName;
  return enName;
}

function statusAnchor(enName: string, locale: string): string {
  if (locale === 'fr') {
    const frName = statusTranslations[enName];
    if (frName) return frName.toLowerCase().replace(/\s+/g, '-');
  }
  return enName.toLowerCase().replace(/\s+/g, '-');
}

function escapeHtml(str: string): string {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// Build locale-name → EN-name reverse map for tooltip lookups
const frToEn: Record<string, string> = {};
for (const [en, fr] of Object.entries(statusTranslations)) {
  frToEn[fr.toLowerCase()] = en;
}

function linkifyStatus(text: unknown): string {
  const str = String(text ?? '');
  const locale = getLang();
  const statuses = locale === 'fr' ? frStatuses : enStatuses;
  const tooltips = locale === 'fr' ? statusTooltipsFr : statusTooltipsEn;
  const prefix = locale === 'fr' ? '/fr' : '';
  const baseUrl = `${prefix}/rules/reference/status_effects`;
  const linkClass = 'text-violet-600 dark:text-violet-400 hover:underline font-semibold';

  let result = escapeHtml(str);
  for (const { name, anchor } of statuses) {
    const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(escaped, 'gi');
    // Look up tooltip by EN key
    const enKey = locale === 'fr' ? (frToEn[name.toLowerCase()] || name) : name;
    const tip = escapeHtml(tooltips[enKey] || '');
    result = result.replace(regex, (match) =>
      `<a href="${baseUrl}#${anchor}" title="${tip}" class="${linkClass}">${match}</a>`
    );
  }
  return result;
}

// Pre-compute ratings for all levels
const levelRatings = (spell.levels || []).map(level => ({
  level,
  rating: rateSpell(level),
}));
---

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="space-y-4">
    <div class="flex items-start justify-between flex-wrap gap-2">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">{spell.name}</h1>
        {spell.spell_series && spell.spell_series !== spell.name && (
          <p class="text-lg text-muted-foreground mt-1">{spell.spell_series}</p>
        )}
      </div>
      <div class="flex gap-2">
        {spell.school && (
          <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${getSchoolColor(spell.school)}`}>
            {t(`school.${spell.school}` as any) !== `school.${spell.school}` ? t(`school.${spell.school}` as any) : spell.school}
          </span>
        )}
        {spell.type && (
          <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${getTypeColor(spell.type)}`}>
            {t(`type.${spell.type}` as any) !== `type.${spell.type}` ? t(`type.${spell.type}` as any) : spell.type}
          </span>
        )}
      </div>
    </div>

    {spell.status_effects && spell.status_effects.length > 0 && (
      <div>
        <h3 class="font-semibold text-sm mb-2">{t('detail.spell.statusEffects')}</h3>
        <div class="flex flex-wrap gap-2">
          {spell.status_effects.map((effect: string) => {
            const locale = getLang();
            const localePrefix = locale === 'fr' ? '/fr' : '';
            const anchor = statusAnchor(effect, locale);
            const href = `${localePrefix}/rules/reference/status_effects#${anchor}`;
            const label = translateStatus(effect, locale);
            const tooltip = statusTooltip(effect, locale);
            return (
              <a href={href} title={tooltip} class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-300 hover:bg-violet-200 dark:hover:bg-violet-800 transition-colors">
                {label}
              </a>
            );
          })}
        </div>
      </div>
    )}

    {spell.description_base && (
      <div>
        <h3 class="font-semibold text-sm mb-2">Description</h3>
        <p class="text-muted-foreground leading-relaxed">{spell.description_base}</p>
      </div>
    )}

    {spell.image && (
      <div class="mt-6">
        <img
          src={`${import.meta.env.BASE_URL}${spell.image}`}
          alt={spell.name || ''}
          class="rounded-lg w-full max-w-2xl mx-auto shadow-lg"
          loading="lazy"
        />
      </div>
    )}
  </div>

  <hr class="border-border" />

  <!-- Levels -->
  {levelRatings.length > 0 && (
    <div>
      <h2 class="text-xl font-semibold mb-4">
        {t('detail.spell.availableLevels')} ({levelRatings.length})
      </h2>
      <div class="space-y-4">
        {levelRatings.map(({ level, rating }) => (
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="flex flex-col space-y-1.5 p-6">
              <div class="flex items-center justify-between">
                <div class="text-lg font-semibold flex items-center gap-2">
                  <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">
                    <span>{t('detail.spell.level')}</span>&nbsp;{level.level}
                  </span>
                  {level.name}
                </div>
              </div>
              {level.description && (
                <p class="text-sm text-muted-foreground mt-2">{level.description}</p>
              )}
            </div>
            <div class="p-6 pt-0 space-y-4">
              <!-- Rating -->
              <div class="bg-gradient-to-r from-purple-50 to-blue-50 dark:from-purple-950/20 dark:to-blue-950/20 rounded-lg p-4 border border-purple-200 dark:border-purple-800">
                <div class="flex items-center justify-between mb-3">
                  <h4 class="font-semibold text-sm">{t('detail.spell.rating')}</h4>
                  <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${rating.tier.colorClass}`}>
                    {rating.tier.name}
                  </span>
                </div>
                <div class="grid grid-cols-3 gap-4 mb-2">
                  <div class="text-center">
                    <div class="text-xs font-medium text-muted-foreground mb-1">{t('detail.spell.power')}</div>
                    <div class="text-2xl font-bold text-amber-600 dark:text-amber-400">{rating.powerScore.toFixed(1)}</div>
                  </div>
                  <div class="text-center">
                    <div class="text-xs font-medium text-muted-foreground mb-1">{t('detail.spell.accessibility')}</div>
                    <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">{rating.accessibilityScore.toFixed(1)}</div>
                  </div>
                  <div class="text-center">
                    <div class="text-xs font-medium text-muted-foreground mb-1">{t('detail.spell.value')}</div>
                    <div class="text-2xl font-bold text-green-600 dark:text-green-400">{rating.valueRating.toFixed(1)}</div>
                  </div>
                </div>
                <div class="text-xs text-muted-foreground text-center pt-2 border-t">
                  {rating.tier.description} • Affinités min: {rating.bestAffinityPath.toFixed(1)}
                </div>
              </div>

              <!-- Prerequisites -->
              <div>
                <h4 class="font-semibold text-sm mb-2">{t('detail.prerequisites')}</h4>
                <div class="space-y-1 text-sm text-muted-foreground">
                  {level.prerequisites?.affinities?.école_requirement && (
                    <div>• <span>{t('detail.spell.schoolReq')}</span> {level.prerequisites.affinities.école_requirement}</div>
                  )}
                  {level.prerequisites?.affinities?.type_requirement && (
                    <div>• <span>{t('detail.spell.typeReq')}</span> {level.prerequisites.affinities.type_requirement}</div>
                  )}
                  {level.prerequisites?.affinities?.mixed_requirement && (
                    <div>• <span>{t('detail.spell.mixedReq')}</span> {level.prerequisites.affinities.mixed_requirement}</div>
                  )}
                  {Array.isArray(level.prerequisites?.affinities) && level.prerequisites.affinities.map((affinity: string) => (
                    <div>• {affinity}</div>
                  ))}
                  {level.prerequisites?.special && (
                    <div>• {level.prerequisites.special}</div>
                  )}
                </div>
              </div>

              <!-- Conditions -->
              <div>
                <h4 class="font-semibold text-sm mb-2">{t('detail.spell.conditions')}</h4>
                <div class="grid grid-cols-2 gap-4 text-sm">
                  {level.conditions?.flux_cost && (
                    <div><span class="font-medium">{t('detail.spell.fluxCost')}</span> {level.conditions.flux_cost}</div>
                  )}
                  {(level.conditions?.recharge || level.recharge_time) && (
                    <div><span class="font-medium">{t('detail.spell.recharge')}</span> {level.conditions?.recharge || level.recharge_time}</div>
                  )}
                  {level.conditions?.intelligence_required && (
                    <div><span class="font-medium">{t('detail.spell.intelligence')}</span> {level.conditions.intelligence_required}</div>
                  )}
                  {level.conditions?.perception_required && (
                    <div><span class="font-medium">{t('detail.spell.perception')}</span> {level.conditions.perception_required}</div>
                  )}
                  {level.conditions?.special && level.conditions.special !== 'aucune' && (
                    <div class="col-span-2"><span class="font-medium">{t('common.special')}</span> {level.conditions.special}</div>
                  )}
                </div>
              </div>

              <!-- Effects -->
              <div>
                <h4 class="font-semibold text-sm mb-2">{t('detail.effects')}</h4>
                <div class="space-y-1 text-sm">
                  {Array.isArray(level.effects) && level.effects.map((effect: string) => (
                    <div><span class="font-medium text-teal-600 dark:text-teal-400">•</span> <Fragment set:html={linkifyStatus(effect)} /></div>
                  ))}
                  {level.effects?.damage && (
                    <div><span class="font-medium text-red-600 dark:text-red-400">{t('common.damage')}</span> <Fragment set:html={linkifyStatus(level.effects.damage)} /></div>
                  )}
                  {level.effects?.area_damage && (
                    <div><span class="font-medium text-red-600 dark:text-red-400">{t('detail.spell.zoneDamage')}</span> <Fragment set:html={linkifyStatus(level.effects.area_damage)} /></div>
                  )}
                  {level.effects?.resistance && (
                    <div><span class="font-medium text-amber-600 dark:text-amber-400">{t('detail.spell.resistance')}</span> <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ml-1">{level.effects.resistance}</span></div>
                  )}
                  {level.effects?.damage_bonus && (
                    <div><span class="font-medium text-red-600 dark:text-red-400">{t('detail.spell.bonusDamage')}</span> <Fragment set:html={linkifyStatus(level.effects.damage_bonus)} /></div>
                  )}
                  {level.effects?.burning_chance && (
                    <div><span class="font-medium text-red-600 dark:text-red-400">{t('detail.spell.burnChance')}</span> <Fragment set:html={linkifyStatus(level.effects.burning_chance)} /></div>
                  )}
                  {level.effects?.debuff && (
                    <div><span class="font-medium text-purple-600 dark:text-purple-400">{t('detail.spell.debuff')}</span> <Fragment set:html={linkifyStatus(level.effects.debuff)} /></div>
                  )}
                  {level.effects?.status && (
                    <div><span class="font-medium text-purple-600 dark:text-purple-400">{t('detail.spell.status')}</span> <Fragment set:html={linkifyStatus(level.effects.status)} /></div>
                  )}
                  {level.effects?.emp && (
                    <div><span class="font-medium text-orange-600 dark:text-orange-400">{t('detail.spell.emp')}</span> <Fragment set:html={linkifyStatus(level.effects.emp)} /></div>
                  )}
                  {level.effects?.movement && (
                    <div><span class="font-medium text-blue-600 dark:text-blue-400">{t('spells.movement')}</span> <Fragment set:html={linkifyStatus(level.effects.movement)} /></div>
                  )}
                  {level.effects?.teleport && (
                    <div><span class="font-medium text-blue-600 dark:text-blue-400">{t('detail.spell.teleport')}</span> <Fragment set:html={linkifyStatus(level.effects.teleport)} /></div>
                  )}
                  {level.effects?.protection && (
                    <div><span class="font-medium text-green-600 dark:text-green-400">{t('common.protection')}</span> <Fragment set:html={linkifyStatus(level.effects.protection)} /></div>
                  )}
                  {level.effects?.defense && (
                    <div><span class="font-medium text-green-600 dark:text-green-400">{t('common.defense')}</span> <Fragment set:html={linkifyStatus(level.effects.defense)} /></div>
                  )}
                  {level.effects?.defense_bonus && (
                    <div><span class="font-medium text-green-600 dark:text-green-400">{t('detail.spell.bonusDefense')}</span> <Fragment set:html={linkifyStatus(level.effects.defense_bonus)} /></div>
                  )}
                  {level.effects?.damage_reduction && (
                    <div><span class="font-medium text-green-600 dark:text-green-400">{t('detail.spell.damageReduction')}</span> <Fragment set:html={linkifyStatus(level.effects.damage_reduction)} /></div>
                  )}
                  {level.effects?.attack_bonus && (
                    <div><span class="font-medium text-yellow-600 dark:text-yellow-400">{t('detail.spell.bonusAttack')}</span> <Fragment set:html={linkifyStatus(level.effects.attack_bonus)} /></div>
                  )}
                  {level.effects?.critical_chance && (
                    <div><span class="font-medium text-yellow-600 dark:text-yellow-400">{t('detail.spell.critical')}</span> <Fragment set:html={linkifyStatus(level.effects.critical_chance)} /></div>
                  )}
                  {level.effects?.multiple_attack && (
                    <div><span class="font-medium text-yellow-600 dark:text-yellow-400">{t('detail.spell.multiAttack')}</span> <Fragment set:html={linkifyStatus(level.effects.multiple_attack)} /></div>
                  )}
                  {level.effects?.information && (
                    <div><span class="font-medium text-gray-600 dark:text-gray-400">{t('detail.spell.information')}</span> <Fragment set:html={linkifyStatus(level.effects.information)} /></div>
                  )}
                  {level.effects?.prediction && (
                    <div><span class="font-medium text-gray-600 dark:text-gray-400">{t('detail.spell.prediction')}</span> <Fragment set:html={linkifyStatus(level.effects.prediction)} /></div>
                  )}
                  {level.effects?.success && (
                    <div><span class="font-medium text-gray-600 dark:text-gray-400">{t('detail.spell.onSuccess')}</span> <Fragment set:html={linkifyStatus(level.effects.success)} /></div>
                  )}
                  {level.effects?.failure && (
                    <div><span class="font-medium text-gray-600 dark:text-gray-400">{t('detail.spell.onFailure')}</span> <Fragment set:html={linkifyStatus(level.effects.failure)} /></div>
                  )}
                  {level.effects?.area && (
                    <div><span class="font-medium text-indigo-600 dark:text-indigo-400">{t('detail.spell.zone')}</span> <Fragment set:html={linkifyStatus(level.effects.area)} /></div>
                  )}
                  {level.effects?.area_effect && (
                    <div><span class="font-medium text-indigo-600 dark:text-indigo-400">{t('detail.spell.zoneEffect')}</span> <Fragment set:html={level.effects.area_effect === true ? t('detail.spell.yes') : linkifyStatus(level.effects.area_effect)} /></div>
                  )}
                  {level.effects?.special && (
                    <div><span class="font-medium text-teal-600 dark:text-teal-400">{t('common.special')}</span> <Fragment set:html={linkifyStatus(level.effects.special)} /></div>
                  )}
                  {level.effects?.spell_enhancement && (
                    <div><span class="font-medium text-teal-600 dark:text-teal-400">{t('detail.spell.enhancement')}</span> <Fragment set:html={linkifyStatus(level.effects.spell_enhancement)} /></div>
                  )}
                  {level.effects?.specials && Array.isArray(level.effects.specials) && level.effects.specials.map((special: string) => (
                    <div><span class="font-medium text-teal-600 dark:text-teal-400">•</span> <Fragment set:html={linkifyStatus(special)} /></div>
                  ))}
                </div>
              </div>

              <!-- Duration & Usage -->
              <div class="flex gap-4 text-sm">
                {level.duration && (
                  <div><span class="font-medium">{t('detail.spell.duration')}</span> {level.duration}</div>
                )}
                {level.usage && (
                  <div><span class="font-medium">{t('detail.spell.usage')}</span> {level.usage}</div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}
</div>
