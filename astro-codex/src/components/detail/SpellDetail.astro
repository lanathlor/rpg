  'Arcanotechnically Resistant': 'Résistance arcanotechnique',
  'Equipment Disabled': 'Équipement désactivé',
  'Mind Controlled': 'Contrôlé mentalement',
  'Knocked Down': 'À terre',
  'Hallucinating': 'Halluciné',
  'Incapacitated': 'Neutralisé',
  'Immobilized': 'Immobilisé',
  'Camouflaged': 'Camouflé',
  'Suppressed': 'Supprimé',
  'Restrained': 'Entravé',
  'Deflecting': 'Déviant',
  'Reinforced': 'Renforcé',
  'Paralyzed': 'Paralysé',
  'Frostbite': 'Gelure',
  'Weakened': 'Affaibli',
  'Shielded': 'Protégé',
  'Fatigued': 'Fatigué',
