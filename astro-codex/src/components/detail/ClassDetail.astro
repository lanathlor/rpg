---
import type { CharacterClass } from '@/types/classes';
import { t } from '@/lib/i18n';

interface Props {
  characterClass: CharacterClass;
}

const { characterClass } = Astro.props;
const base = import.meta.env.BASE_URL;

function getSchoolColor(school: string): string {
  const colors: Record<string, string> = {
    'feu': 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300',
    'givre': 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900 dark:text-cyan-300',
    'électricité': 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300',
    'quantique': 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300',
    'pure': 'bg-white text-gray-800 dark:bg-gray-200 dark:text-gray-800',
    'bioarcanotechnique': 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-300',
    'biométabolique': 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-300',
    'magnétique': 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-300',
    'chronodynamique': 'bg-teal-100 text-teal-800 dark:bg-teal-900 dark:text-teal-300',
    'gravitonique': 'bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-300',
    'aérocinétique': 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-300',
    'hydrodynamique': 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300',
    'sonique': 'bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300',
    'illusion': 'bg-pink-100 text-pink-800 dark:bg-pink-900 dark:text-pink-300',
    'martial': 'bg-rose-100 text-rose-800 dark:bg-rose-900 dark:text-rose-300',
    'balistique': 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300',
    'kinesthésique': 'bg-stone-100 text-stone-800 dark:bg-stone-800 dark:text-stone-300',
    'lumière': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-300',
    'ombre': 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-300',
  };
  return colors[school] || 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300';
}

const statLabels: Record<string, string> = {
  force: 'Force',
  dexterite: 'Dextérité',
  constitution: 'Constitution',
  intelligence: 'Intelligence',
  perception: 'Perception',
  precision: 'Précision',
  charisme: 'Charisme',
};

const statColors: Record<string, string> = {
  force: 'text-red-500',
  dexterite: 'text-yellow-500',
  constitution: 'text-green-500',
  intelligence: 'text-purple-500',
  perception: 'text-blue-500',
  precision: 'text-orange-500',
  charisme: 'text-pink-500',
};

// Extract affinities
const affinities = characterClass.affinities || {};
const schools = affinities.schools || {};
const types = affinities.types || {};
const hasEquipment = characterClass.equipment && (
  (characterClass.equipment.weapons?.length > 0) ||
  (characterClass.equipment.armor?.length > 0) ||
  (characterClass.equipment.consumables?.length > 0)
);
---

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="space-y-4">
    <h1 class="text-3xl font-bold tracking-tight">{characterClass.name}</h1>
    {characterClass.description && (
      <p class="text-lg text-muted-foreground leading-relaxed">{characterClass.description}</p>
    )}
    {characterClass.image && (
      <div class="mt-6">
        <img src={`${base}${characterClass.image}`} alt={characterClass.name} class="rounded-lg w-full max-w-2xl mx-auto shadow-lg" loading="lazy" />
      </div>
    )}
  </div>

  <hr class="border-border" />

  <!-- Base Stats & Character Stats -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    {characterClass.base_stats && (
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
        <div class="flex flex-col space-y-1.5 p-6"><h3 class="text-lg font-semibold">{t('detail.class.baseStats')}</h3></div>
        <div class="p-6 pt-0 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <span class="text-sm font-medium text-muted-foreground">{t('detail.class.health')}</span>
              <div class="text-lg font-semibold mt-1">{characterClass.base_stats.health} PV</div>
            </div>
            <div>
              <span class="text-sm font-medium text-muted-foreground">{t('detail.class.speed')}</span>
              <div class="text-lg font-semibold mt-1">{characterClass.base_stats.speed} <span>{t('detail.class.mPerTurn')}</span></div>
            </div>
          </div>

          {characterClass.flux_system && (
            <div>
              <h4 class="font-medium text-sm mb-2">{t('detail.class.fluxSystem')}</h4>
              <div class="grid grid-cols-3 gap-2 text-sm">
                <div><span class="text-muted-foreground">{t('detail.class.reserve')}</span><div class="font-semibold">{characterClass.flux_system.reserve}</div></div>
                <div><span class="text-muted-foreground">{t('detail.class.perTurn')}</span><div class="font-semibold">{characterClass.flux_system.per_turn}</div></div>
                <div><span class="text-muted-foreground">{t('detail.class.recovery')}</span><div class="font-semibold">{characterClass.flux_system.recovery}</div></div>
              </div>
            </div>
          )}

          <div>
            <h4 class="font-medium text-sm mb-2">{t('detail.class.innateResistances')}</h4>
            <div class="grid grid-cols-3 gap-2 text-sm">
              <div><span class="text-muted-foreground">RMEC:</span><div class="font-semibold">{characterClass.innate_resistances?.RMEC ?? 0}</div></div>
              <div><span class="text-muted-foreground">RRAD:</span><div class="font-semibold">{characterClass.innate_resistances?.RRAD ?? 0}</div></div>
              <div><span class="text-muted-foreground">RINT:</span><div class="font-semibold">{characterClass.innate_resistances?.RINT ?? 0}</div></div>
            </div>
          </div>
        </div>
      </div>
    )}

    {characterClass.stats && (
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
        <div class="flex flex-col space-y-1.5 p-6"><h3 class="text-lg font-semibold">{t('detail.class.characteristics')}</h3></div>
        <div class="p-6 pt-0">
          <div class="grid grid-cols-2 gap-3">
            {Object.entries(characterClass.stats).map(([statName, value]) => (
              <div class="flex items-center justify-between">
                <span class={`text-sm font-medium ${statColors[statName] || ''}`}>{statLabels[statName] || statName}</span>
                <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-0.5 text-xs font-semibold">{value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>

  <!-- Affinities -->
  {(Object.keys(schools).length > 0 || Object.keys(types).length > 0 || affinities.distance || affinities.melee) && (
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col space-y-1.5 p-6"><h3 class="text-lg font-semibold">{t('detail.class.affinities')}</h3></div>
      <div class="p-6 pt-0 space-y-4">
        {(affinities.distance || affinities.melee) && (
          <div>
            <h4 class="text-sm font-medium mb-3 text-muted-foreground">{t('detail.class.combat')}</h4>
            <div class="grid grid-cols-2 gap-2">
              {affinities.distance && (
                <div class="flex items-center justify-between">
                  <span class="text-sm">{t('detail.class.ranged')}</span>
                  <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-0.5 text-xs font-semibold">{affinities.distance}</span>
                </div>
              )}
              {affinities.melee && (
                <div class="flex items-center justify-between">
                  <span class="text-sm">{t('detail.class.melee')}</span>
                  <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-0.5 text-xs font-semibold">{affinities.melee}</span>
                </div>
              )}
            </div>
          </div>
        )}
        {Object.keys(schools).length > 0 && (
          <div>
            <h4 class="text-sm font-medium mb-3 text-muted-foreground">{t('detail.class.schools')}</h4>
            <div class="grid grid-cols-2 gap-2">
              {Object.entries(schools).map(([school, level]) => level > 0 && (
                <div class="flex items-center justify-between">
                  <span class="text-sm capitalize">{school}</span>
                  <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${getSchoolColor(school)}`}>{level}</span>
                </div>
              ))}
            </div>
          </div>
        )}
        {Object.keys(types).length > 0 && (
          <div class="border-t pt-4">
            <h4 class="text-sm font-medium mb-3 text-muted-foreground">{t('detail.class.types')}</h4>
            <div class="grid grid-cols-2 gap-2">
              {Object.entries(types).map(([type, level]) => level > 0 && (
                <div class="flex items-center justify-between">
                  <span class="text-sm capitalize">{type}</span>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">{level}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Equipment -->
  {hasEquipment && (
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col space-y-1.5 p-6"><h3 class="text-lg font-semibold">{t('detail.class.startingEquipment')}</h3></div>
      <div class="p-6 pt-0 space-y-4">
        {characterClass.equipment.weapons?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-muted-foreground mb-2">{t('detail.class.weapons')}</h4>
            <div class="flex flex-wrap gap-2">
              {characterClass.equipment.weapons.map((w: string) => (
                <a href={`${base}armes/${w.toLowerCase().replace(/\s+/g, '_').replace(/[éè]/g, 'e').replace(/[à]/g, 'a')}/`} class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold hover:bg-accent transition-colors">{w}</a>
              ))}
            </div>
          </div>
        )}
        {characterClass.equipment.armor?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-muted-foreground mb-2">{t('detail.class.armor')}</h4>
            <div class="flex flex-wrap gap-2">
              {characterClass.equipment.armor.map((a: string) => (
                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">{a}</span>
              ))}
            </div>
          </div>
        )}
        {characterClass.equipment.consumables?.length > 0 && (
          <div>
            <h4 class="text-sm font-medium text-muted-foreground mb-2">{t('detail.class.consumables')}</h4>
            <div class="flex flex-wrap gap-2">
              {characterClass.equipment.consumables.map((item: any) => (
                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">
                  {item.name}{item.quantity > 1 && ` x${item.quantity}`}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Skills -->
  {characterClass.skills?.length > 0 && (
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col space-y-1.5 p-6"><h3 class="text-lg font-semibold">{t('detail.class.skills')}</h3></div>
      <div class="p-6 pt-0">
        <div class="flex flex-wrap gap-2">
          {characterClass.skills.map((skill: string) => (
            <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Spells -->
  {characterClass.spells?.length > 0 && (
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col space-y-1.5 p-6"><h3 class="text-lg font-semibold">{t('detail.class.spells')}</h3></div>
      <div class="p-6 pt-0">
        <div class="flex flex-wrap gap-2">
          {characterClass.spells.map((spell: any) => {
            const spellName = typeof spell === 'string' ? spell : spell.series || spell.name;
            return (
              <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">{spellName}</span>
            );
          })}
        </div>
      </div>
    </div>
  )}

  <!-- Gameplay Guide -->
  {characterClass.gameplay_guide && (
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col space-y-1.5 p-6"><h3 class="text-lg font-semibold">{t('detail.class.gameplayGuide')}</h3></div>
      <div class="p-6 pt-0">
        <p class="text-muted-foreground leading-relaxed">{characterClass.gameplay_guide}</p>
      </div>
    </div>
  )}
</div>
