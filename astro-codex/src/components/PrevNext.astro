---
import type { TreeNode } from '@/lib/treeUtils';
import type { Lang } from '@/lib/i18n';

interface Props {
  prev: TreeNode | null;
  next: TreeNode | null;
  section: string;
}

const { prev, next, section } = Astro.props;
const locale = (Astro.params.locale || Astro.url.pathname.match(/\/rpg\/(en|fr)\//)?.[1] || 'en') as Lang;
const base = import.meta.env.BASE_URL + locale + '/';
---

{(prev || next) && (
  <nav class="mt-12 pt-6 border-t flex justify-between items-center gap-4" aria-label="Pagination">
    {prev ? (
      <a href={`${base}${section}/${prev.path}/`}
         class="flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground group max-w-[45%]">
        <span class="shrink-0" aria-hidden="true">&larr;</span>
        <span class="truncate group-hover:underline">{prev.title}</span>
      </a>
    ) : <div />}
    {next ? (
      <a href={`${base}${section}/${next.path}/`}
         class="flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground group max-w-[45%] ml-auto text-right">
        <span class="truncate group-hover:underline">{next.title}</span>
        <span class="shrink-0" aria-hidden="true">&rarr;</span>
      </a>
    ) : <div />}
  </nav>
)}
