---
import SidebarTree from './SidebarTree.astro';
import { getRulesTree, getHistoryTree } from '@/lib/dataUtils';
import { findAncestors } from '@/lib/treeUtils';
import { t, type Lang } from '@/lib/i18n';

const locale = (Astro.currentLocale || 'en') as Lang;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL + locale + '/';

function isActive(href: string): boolean {
  const fullHref = base + href.replace(/^\//, '');
  if (href === '/') {
    return pathname === base || pathname === base.replace(/\/$/, '');
  }
  return pathname.startsWith(fullHref);
}

const navigationItems = [
  { name: t('nav.home'), href: '/', description: '' },
  { name: t('nav.rules'), href: '/regles/', description: t('nav.rulesDesc'), section: 'regles' },
  { name: t('nav.history'), href: '/histoire/', description: t('nav.historyDesc'), section: 'histoire' },
  { name: t('nav.scenarios'), href: '/scenarios/', description: t('nav.scenariosDesc') },
  { name: t('nav.spells'), href: '/sorts/', description: t('nav.spellsDesc') },
  { name: t('nav.weapons'), href: '/armes/', description: t('nav.weaponsDesc') },
  { name: t('nav.equipment'), href: '/equipements/', description: t('nav.equipmentDesc') },
  { name: t('nav.skills'), href: '/competences/', description: t('nav.skillsDesc') },
  { name: t('nav.consumables'), href: '/consommables/', description: t('nav.consumablesDesc') },
  { name: t('nav.classes'), href: '/classes/', description: t('nav.classesDesc') },
  { name: t('nav.entities'), href: '/entites/', description: t('nav.entitiesDesc') },
  { name: t('nav.characters'), href: '/personnages/', description: t('nav.charactersDesc') },
  { name: t('nav.search'), href: '/search/', description: t('nav.searchDesc') },
];

// Detect sections and load trees
const isReglesSection = pathname.startsWith(base + 'regles');
const isHistoireSection = pathname.startsWith(base + 'histoire');

function extractSlug(section: string): string {
  const prefix = base + section + '/';
  return pathname.replace(prefix, '').replace(/\/$/, '') || '';
}

let rulesTree = null;
let historyTree = null;
let rulesActivePath = '';
let historyActivePath = '';
let rulesAncestors: string[] = [];
let historyAncestors: string[] = [];

if (isReglesSection) {
  rulesTree = await getRulesTree();
  rulesActivePath = extractSlug('regles');
  rulesAncestors = findAncestors(rulesTree, rulesActivePath);
}
if (isHistoireSection) {
  historyTree = await getHistoryTree();
  historyActivePath = extractSlug('histoire');
  historyAncestors = findAncestors(historyTree, historyActivePath);
}
---

<div class="pb-12 w-64">
  <div class="space-y-4 py-4">
    <div class="px-3 py-2">
      <h2 class="mb-2 px-4 text-lg font-semibold tracking-tight">
        {t('nav.title')}
      </h2>
      <div class="space-y-1">
        {navigationItems.map((item) => (
          <>
            <a
              href={`${base}${item.href.replace(/^\//, '')}`}
              class:list={[
                'flex items-center rounded-lg px-3 py-2 text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors',
                isActive(item.href)
                  ? 'bg-primary text-primary-foreground'
                  : 'text-muted-foreground'
              ]}
            >
              <div class="flex flex-col">
                <span>{item.name}</span>
                {item.description && (
                  <span class="text-xs opacity-70">{item.description}</span>
                )}
              </div>
            </a>
            {item.section === 'regles' && isReglesSection && rulesTree && (
              <div class="mt-1 mb-2 ml-2">
                <SidebarTree
                  nodes={rulesTree}
                  section="regles"
                  activePath={rulesActivePath}
                  ancestorPaths={rulesAncestors}
                  base={base}
                />
              </div>
            )}
            {item.section === 'histoire' && isHistoireSection && historyTree && (
              <div class="mt-1 mb-2 ml-2">
                <SidebarTree
                  nodes={historyTree}
                  section="histoire"
                  activePath={historyActivePath}
                  ancestorPaths={historyAncestors}
                  base={base}
                />
              </div>
            )}
          </>
        ))}
      </div>
    </div>
  </div>
</div>
