---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t } from '@/lib/i18n';
import { ClassListIsland } from '@/components/islands/ClassListIsland';
import { getClasses, getWeapons, getArmors, getSkills, getConsumables } from '@/lib/dataUtils';
import { calculateTotalPointBuy } from '@/lib/pointBuyCalculator';



const locale = 'en';
setLang(locale);

const [classes, allWeapons, allArmors, allSkills, allConsumables] = await Promise.all([
  getClasses(locale), getWeapons(locale), getArmors(locale), getSkills(locale), getConsumables(locale),
]);
const base = import.meta.env.BASE_URL;

const weaponData = allWeapons.map(w => w.data);
const armorData = allArmors.map(a => a.data);
const skillData = allSkills.map(s => s.data);
const consumableData = allConsumables.map(c => c.data);

const statLabels: Record<string, string> = {
  force: 'Force', dexterite: 'Dextérité', constitution: 'Constitution',
  intelligence: 'Intelligence', perception: 'Perception', precision: 'Précision', charisme: 'Charisme',
};

function getHighestStat(stats: any): { name: string; value: number } {
  if (!stats) return { name: '', value: 0 };
  let best = { name: '', value: 0 };
  for (const [k, v] of Object.entries(stats)) {
    if (typeof v === 'number' && v > best.value) {
      best = { name: statLabels[k] || k, value: v };
    }
  }
  return best;
}

const items = classes.map(c => {
  let points = 0;
  try { points = calculateTotalPointBuy(c.data as any, weaponData as any, armorData as any, skillData as any, consumableData as any).total; } catch {}
  const highest = getHighestStat(c.data.stats);
  const spells = c.data.spells || [];
  const skills = c.data.skills || [];
  const weapons = c.data.equipment?.weapons || [];
  return {
    slug: c.slug,
    name: c.data.name,
    description: c.data.description || '',
    health: c.data.base_stats?.health ?? 0,
    speed: c.data.base_stats?.speed ?? 0,
    fluxReserve: c.data.flux_system?.reserve ?? 0,
    highestStat: highest.value,
    highestStatName: highest.name,
    points,
    rmec: c.data.innate_resistances?.RMEC ?? 0,
    rrad: c.data.innate_resistances?.RRAD ?? 0,
    rint: c.data.innate_resistances?.RINT ?? 0,
    spellCount: spells.length,
    skillCount: skills.length,
    weaponCount: weapons.length,
  };
}).sort((a, b) => a.name.localeCompare(b.name));
---

<MainLayout title="Classes - Pyrrhic Stars" description="Classes de personnages jouables">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t('page.classes.title')}</h1>
      <p class="text-lg text-muted-foreground">{items.length} {t('page.classes.available')}</p>
    </div>
    <ClassListIsland classes={items} base={base} client:load />
  </div>
</MainLayout>
