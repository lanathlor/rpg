---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t } from '@/lib/i18n';
import EntityDetail from '@/components/detail/EntityDetail.astro';
import { getEntities, buildLinkMaps } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const [entities, linkMaps] = await Promise.all([getEntities('en'), buildLinkMaps()]);
  return entities.map(e => ({
    params: { slug: e.slug },
    props: { entity: e.data, linkMaps },
  }));
}

const { entity, linkMaps } = Astro.props;
const locale = 'en';
setLang(locale);
const base = import.meta.env.BASE_URL;
---

<MainLayout title={`${entity.name} - Entités - Pyrrhic Stars`} description={entity.description}>
  <div>
    <a href={`${base}entities/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">{t('page.back.entities')}</a>
    <EntityDetail entity={entity} linkMaps={linkMaps} />
  </div>
</MainLayout>
