---
import MainLayout from '@/layouts/MainLayout.astro';
import SkillDetail from '@/components/detail/SkillDetail.astro';
import { getSkills } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const skills = await getSkills();
  return skills.map(s => ({
    params: { slug: s.slug },
    props: { skill: s.data },
  }));
}

const { skill } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<MainLayout title={`${skill.name} - Compétences - Pyrrhic Stars`} description={skill.description}>
  <div>
    <a href={`${base}competences/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">&larr; Retour aux compétences</a>
    <SkillDetail skill={skill} />
  </div>
</MainLayout>
