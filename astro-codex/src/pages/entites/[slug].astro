---
import MainLayout from '@/layouts/MainLayout.astro';
import EntityDetail from '@/components/detail/EntityDetail.astro';
import { getEntities } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const entities = await getEntities();
  return entities.map(e => ({
    params: { slug: e.slug },
    props: { entity: e.data },
  }));
}

const { entity } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<MainLayout title={`${entity.name} - Entités - Codex RPG`} description={entity.description}>
  <div>
    <a href={`${base}entites/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">&larr; Retour aux entités</a>
    <EntityDetail entity={entity} />
  </div>
</MainLayout>
