---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t, type Lang } from '@/lib/i18n';
import SpellDetail from '@/components/detail/SpellDetail.astro';
import { getSpells } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const locales = ['en', 'fr'] as const;
  const results = await Promise.all(locales.map(async locale => {
    const spells = await getSpells(locale);
    return spells.map(spell => ({
      params: { locale, slug: spell.slug },
      props: { spell: spell.data },
    }));
  }));
  return results.flat();
}

const { spell } = Astro.props;
const locale = Astro.params.locale as Lang;
setLang(locale);
const base = import.meta.env.BASE_URL + locale + '/';
---

<MainLayout title={`${spell.name || spell.spell_series} - Sorts - Pyrrhic Stars`} description={spell.description_base}>
  <div>
    <a href={`${base}spells/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">
      {t('page.back.spells')}
    </a>
    <SpellDetail spell={spell} />
  </div>
</MainLayout>
