---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t, type Lang } from '@/lib/i18n';
import { WeaponListIsland } from '@/components/islands/WeaponListIsland';
import { getWeapons } from '@/lib/dataUtils';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = Astro.params.locale as Lang;
setLang(locale);

const weapons = await getWeapons();
const base = import.meta.env.BASE_URL + locale + '/';

function parseCost(cost?: string): number {
  if (!cost) return 0;
  const match = cost.match(/(\d+)/);
  return match ? parseInt(match[1], 10) : 0;
}

const items = weapons.map(w => ({
  slug: w.slug,
  name: w.data.name,
  category: w.data.category || '',
  type: w.data.type || '',
  subcategory: w.data.subcategory || '',
  description: w.data.description || '',
  damage: w.data.stats?.damage || '',
  attackType: w.data.stats?.attack_type || '',
  range: w.data.stats?.range || '',
  cost: w.data.cost || '',
  costNum: parseCost(w.data.cost),
})).sort((a, b) => a.name.localeCompare(b.name));
---

<MainLayout title="Armes - Pyrrhic Stars" description="Catalogue de toutes les armes disponibles">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t('page.weapons.title')}</h1>
      <p class="text-lg text-muted-foreground">{items.length} {t('page.weapons.available')}</p>
    </div>
    <WeaponListIsland weapons={items} base={base} client:load />
  </div>
</MainLayout>
