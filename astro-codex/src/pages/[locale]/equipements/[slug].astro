---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t, type Lang } from '@/lib/i18n';
import ArmorDetail from '@/components/detail/ArmorDetail.astro';
import { getArmors } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const armors = await getArmors();
  const locales = ['en', 'fr'];
  return locales.flatMap(locale =>
    armors.map(a => ({
      params: { locale, slug: a.slug },
      props: { armor: a.data },
    }))
  );
}

const { armor } = Astro.props;
const locale = Astro.params.locale as Lang;
setLang(locale);
const base = import.meta.env.BASE_URL + locale + '/';
---

<MainLayout title={`${armor.name} - Équipements - Pyrrhic Stars`} description={armor.description}>
  <div>
    <a href={`${base}equipements/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">{t('page.back.equipment')}</a>
    <ArmorDetail armor={armor} />
  </div>
</MainLayout>
