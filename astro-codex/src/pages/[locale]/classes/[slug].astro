---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t, type Lang } from '@/lib/i18n';
import ClassDetail from '@/components/detail/ClassDetail.astro';
import { getClasses } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const locales = ['en', 'fr'] as const;
  const results = await Promise.all(locales.map(async locale => {
    const classes = await getClasses(locale);
    return classes.map(c => ({
      params: { locale, slug: c.slug },
      props: { characterClass: c.data },
    }));
  }));
  return results.flat();
}

const { characterClass } = Astro.props;
const locale = Astro.params.locale as Lang;
setLang(locale);
const base = import.meta.env.BASE_URL + locale + '/';
---

<MainLayout title={`${characterClass.name} - Classes - Pyrrhic Stars`} description={characterClass.description}>
  <div>
    <a href={`${base}classes/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">{t('page.back.classes')}</a>
    <ClassDetail characterClass={characterClass} />
  </div>
</MainLayout>
