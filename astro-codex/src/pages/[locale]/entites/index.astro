---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t, type Lang } from '@/lib/i18n';
import { EntityListIsland } from '@/components/islands/EntityListIsland';
import { getEntities, getWeapons, getArmors, getSkills, getConsumables } from '@/lib/dataUtils';
import { calculateTotalPointBuy } from '@/lib/pointBuyCalculator';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'fr' } }];
}

const locale = Astro.params.locale as Lang;
setLang(locale);

const [entities, allWeapons, allArmors, allSkills, allConsumables] = await Promise.all([
  getEntities(), getWeapons(), getArmors(), getSkills(), getConsumables(),
]);
const base = import.meta.env.BASE_URL + locale + '/';

const weaponData = allWeapons.map(w => w.data);
const armorData = allArmors.map(a => a.data);
const skillData = allSkills.map(s => s.data);
const consumableData = allConsumables.map(c => c.data);

const statLabels: Record<string, string> = {
  force: 'Force', dexterite: 'Dextérité', constitution: 'Constitution',
  intelligence: 'Intelligence', perception: 'Perception', precision: 'Précision', charisme: 'Charisme',
};

function getHighestStat(stats: any): { name: string; value: number } {
  if (!stats) return { name: '', value: 0 };
  let best = { name: '', value: 0 };
  for (const [k, v] of Object.entries(stats)) {
    if (typeof v === 'number' && v > best.value) {
      best = { name: statLabels[k] || k, value: v };
    }
  }
  return best;
}

const items = entities.map(e => {
  let points = 0;
  try { points = calculateTotalPointBuy(e.data as any, weaponData as any, armorData as any, skillData as any, consumableData as any).total; } catch {}
  const highest = getHighestStat(e.data.stats);
  const spells = e.data.spells || [];
  const skills = e.data.skills || [];
  const weapons = e.data.equipment?.weapons || [];
  return {
    slug: e.slug,
    name: e.data.name,
    description: e.data.description || '',
    faction: e.data.faction || '',
    alignement: e.data.alignement || '',
    type: e.data.type || '',
    health: e.data.base_stats?.health ?? 0,
    speed: e.data.base_stats?.speed ?? 0,
    highestStat: highest.value,
    highestStatName: highest.name,
    points,
    rmec: e.data.innate_resistances?.RMEC ?? 0,
    rrad: e.data.innate_resistances?.RRAD ?? 0,
    rint: e.data.innate_resistances?.RINT ?? 0,
    spellCount: spells.length,
    skillCount: skills.length,
    weaponCount: weapons.length,
  };
}).sort((a, b) => a.name.localeCompare(b.name));
---

<MainLayout title="Entités - Pyrrhic Stars" description="PNJ et créatures de l'univers">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t('page.entities.title')}</h1>
      <p class="text-lg text-muted-foreground">{items.length} {t('page.entities.available')}</p>
    </div>
    <EntityListIsland entities={items} base={base} client:load />
  </div>
</MainLayout>
