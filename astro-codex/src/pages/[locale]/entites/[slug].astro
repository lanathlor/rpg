---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t, type Lang } from '@/lib/i18n';
import EntityDetail from '@/components/detail/EntityDetail.astro';
import { getEntities } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const entities = await getEntities();
  const locales = ['en', 'fr'];
  return locales.flatMap(locale =>
    entities.map(e => ({
      params: { locale, slug: e.slug },
      props: { entity: e.data },
    }))
  );
}

const { entity } = Astro.props;
const locale = Astro.params.locale as Lang;
setLang(locale);
const base = import.meta.env.BASE_URL + locale + '/';
---

<MainLayout title={`${entity.name} - Entités - Pyrrhic Stars`} description={entity.description}>
  <div>
    <a href={`${base}entites/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">{t('page.back.entities')}</a>
    <EntityDetail entity={entity} />
  </div>
</MainLayout>
