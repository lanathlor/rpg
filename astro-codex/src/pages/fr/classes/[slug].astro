---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t } from '@/lib/i18n';
import ClassDetail from '@/components/detail/ClassDetail.astro';
import { getClasses, buildLinkMaps } from '@/lib/dataUtils';

export async function getStaticPaths() {
  const [classes, linkMaps] = await Promise.all([getClasses('fr'), buildLinkMaps()]);
  return classes.map(c => ({
    params: { slug: c.slug },
    props: { characterClass: c.data, linkMaps },
  }));
}

const { characterClass, linkMaps } = Astro.props;
const locale = 'fr';
setLang(locale);
const base = import.meta.env.BASE_URL + 'fr/';
---

<MainLayout title={`${characterClass.name} - Classes - Pyrrhic Stars`} description={characterClass.description}>
  <div>
    <a href={`${base}classes/`} class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block">{t('page.back.classes')}</a>
    <ClassDetail characterClass={characterClass} linkMaps={linkMaps} />
  </div>
</MainLayout>
