---
import MainLayout from '@/layouts/MainLayout.astro';
import Icon from '@/components/Icon.astro';
import { setLang, t } from '@/lib/i18n';
import { getRulesTree } from '@/lib/dataUtils';



const locale = 'fr';
setLang(locale);

const base = import.meta.env.BASE_URL + 'fr/';
const tree = await getRulesTree(locale);

const categoryMeta: Record<string, { icon: string; color: string }> = {
  'fundamentals': { icon: 'target', color: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300' },
  'combat': { icon: 'swords', color: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300' },
  'arcanotechnology': { icon: 'sparkles', color: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300' },
  'reference': { icon: 'book-open', color: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-300' },
};
---

<MainLayout title="Regles - Pyrrhic Stars" description="Guide complet des regles et mecaniques du systeme de jeu">
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t('page.rules.title')}</h1>
      <p class="text-lg text-muted-foreground">
        {t('page.rules.description')}
      </p>
    </div>

    {tree.map(category => {
      const meta = categoryMeta[category.segment] || { icon: 'book-open', color: 'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-300' };
      const items = category.children;
      return (
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <Icon name={meta.icon} class="h-4 w-4" />
            <h2 class="text-xl font-semibold">{category.title}</h2>
            <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">
              {items.length} {t('page.rules.sections')}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {items.map(item => (
              <a href={`${base}rules/${item.path}/`} class="block">
                <div class="rounded-lg border bg-card text-card-foreground shadow-sm hover:shadow-lg transition-all cursor-pointer group h-full">
                  <div class="flex flex-col space-y-1.5 p-6">
                    <div class="flex items-center gap-3">
                      <div class={`p-2 rounded-lg ${meta.color}`}>
                        <Icon name={meta.icon} />
                      </div>
                      <h3 class="text-lg font-semibold group-hover:text-primary transition-colors">
                        {item.title}
                      </h3>
                    </div>
                    {item.description && (
                      <p class="text-sm text-muted-foreground line-clamp-3">
                        {item.description}
                      </p>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</MainLayout>
