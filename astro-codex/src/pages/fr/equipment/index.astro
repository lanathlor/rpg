---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t } from '@/lib/i18n';
import { ArmorListIsland } from '@/components/islands/ArmorListIsland';
import { getArmors } from '@/lib/dataUtils';



const locale = 'fr';
setLang(locale);

const armors = await getArmors(locale);
const base = import.meta.env.BASE_URL + 'fr/';

function parseCost(cost?: string): number {
  if (!cost) return 0;
  const match = cost.match(/(\d+)/);
  return match ? parseInt(match[1], 10) : 0;
}

const items = armors.map(a => ({
  slug: a.slug,
  name: a.data.name,
  category: a.data.category || '',
  subcategory: a.data.subcategory || '',
  description: a.data.description || '',
  RMEC: a.data.stats?.RMEC || '',
  RRAD: a.data.stats?.RRAD || '',
  RINT: a.data.stats?.RINT || '',
  defensebonus: a.data.stats?.defense_bonus || '',
  cost: a.data.cost || '',
  costNum: parseCost(a.data.cost),
})).sort((a, b) => a.name.localeCompare(b.name));
---

<MainLayout title="Équipements - Pyrrhic Stars" description="Armures, implants et équipements tactiques">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{t('page.equipment.title')}</h1>
      <p class="text-lg text-muted-foreground">{items.length} {t('page.equipment.available')}</p>
    </div>
    <ArmorListIsland armors={items} base={base} client:load />
  </div>
</MainLayout>
