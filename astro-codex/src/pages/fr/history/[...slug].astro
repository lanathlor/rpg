---
import MainLayout from '@/layouts/MainLayout.astro';
import { setLang, t } from '@/lib/i18n';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PrevNext from '@/components/PrevNext.astro';
import { getHistory, getHistoryTree } from '@/lib/dataUtils';
import { flattenTree, findAncestors, type TreeNode } from '@/lib/treeUtils';

export async function getStaticPaths() {
  const entries = await getHistory('fr');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry, slug: entry.id },
  }));
}

const { entry, slug } = Astro.props;
const locale = 'fr';
setLang(locale);

const base = import.meta.env.BASE_URL + 'fr/';

// Get pre-processed HTML directly from entry data
const renderedHtml = (entry.data as any).renderedHtml ?? '';

const title = (entry.data as any).title || slug;

// Build tree for prev/next and child cards
const tree = await getHistoryTree(locale);
const flatList = flattenTree(tree);
const currentIndex = flatList.findIndex(n => n.path === slug);
const prev = currentIndex > 0 ? flatList[currentIndex - 1] : null;
const next = currentIndex < flatList.length - 1 ? flatList[currentIndex + 1] : null;

// Find node in tree to check for children
function findNode(nodes: TreeNode[], path: string): TreeNode | undefined {
  for (const n of nodes) {
    if (n.path === path) return n;
    const found = findNode(n.children, path);
    if (found) return found;
  }
}
const currentNode = findNode(tree, slug);
const childPages = currentNode?.children ?? [];

// Build breadcrumb segments
const parts = slug.split('/');
const breadcrumbs: Array<{ label: string; href?: string }> = [
  { label: t('nav.history'), href: `${base}history/` },
];
let currentPath = '';
for (let i = 0; i < parts.length; i++) {
  currentPath = currentPath ? `${currentPath}/${parts[i]}` : parts[i];
  if (i < parts.length - 1) {
    function findTitle(nodes: TreeNode[], path: string): string {
      for (const n of nodes) {
        if (n.path === path) return n.title;
        const found = findTitle(n.children, path);
        if (found) return found;
      }
      return '';
    }
    const segTitle = findTitle(tree, currentPath) || parts[i];
    breadcrumbs.push({ label: segTitle, href: `${base}history/${currentPath}/` });
  } else {
    breadcrumbs.push({ label: title });
  }
}
---

<MainLayout title={`${title} - Histoire - Pyrrhic Stars`}>
  <div class="max-w-4xl mx-auto">
    <Breadcrumb segments={breadcrumbs} />

    <article class="prose prose-slate dark:prose-invert max-w-none">
      <h1>{title}</h1>
      {(entry.data as any).description && (
        <p class="text-lg text-muted-foreground">{(entry.data as any).description}</p>
      )}
      <div set:html={renderedHtml} />
    </article>

    {childPages.length > 0 && (
      <div class="mt-6 space-y-4">
        {childPages.map(child => (
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm overflow-hidden">
            <a href={`${base}history/${child.path}/`}
               class="block p-5 hover:bg-accent/50 transition-colors">
              <h3 class="text-lg font-semibold text-foreground">{child.title}</h3>
              {child.description && (
                <p class="text-sm text-muted-foreground mt-1">{child.description}</p>
              )}
            </a>
            {child.children.length > 0 && (
              <div class="border-t px-5 py-3 bg-muted/30">
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
                  {child.children.map(sub => (
                    <li>
                      <a href={`${base}history/${sub.path}/`}
                         class="text-sm text-muted-foreground hover:text-foreground transition-colors py-0.5 inline-flex items-center gap-1.5">
                        <span class="text-border">-</span>
                        {sub.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </div>
    )}

    <PrevNext prev={prev} next={next} section="history" />
  </div>
</MainLayout>
